{
  "Comment": "Pipeline Martech Flutter Brazil. Cada lambda e nomeada pela camada que PRODUZ: fx->reference, silver->silver, gold->gold. Sequencial porque cada uma le a saida da anterior.",
  "StartAt": "Cambio",
  "TimeoutSeconds": 1800,
  "States": {
    "Cambio": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fx_arn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.cambio",
      "ResultSelector": {
        "rows.$": "$.Payload.rows",
        "degraded.$": "$.Payload.degraded_mode",
        "dq.$": "$.Payload.dq"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "Comment": "So falha transitoria de infra. Reprovacao de DQ NAO e retentada: repetir dado ruim so gasta dinheiro para falhar igual."
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.erro",
          "Next": "NotificarFalha"
        }
      ],
      "Next": "Silver",
      "Comment": "Roda primeiro: a silver le reference/fx_rates/current para converter os valores."
    },
    "Silver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${silver_arn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.silver",
      "ResultSelector": {
        "ok.$": "$.Payload.ok",
        "failed.$": "$.Payload.failed",
        "dq.$": "$.Payload.dq"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.erro",
          "Next": "NotificarFalha"
        }
      ],
      "Next": "Gold",
      "Comment": "bronze/ -> silver/. Valida, deduplica, quarentena, tipa, converte para BRL e parseia a taxonomia."
    },
    "Gold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${gold_arn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.gold",
      "ResultSelector": {
        "tables.$": "$.Payload.tables",
        "written.$": "$.Payload.written",
        "dq.$": "$.Payload.dq"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.erro",
          "Next": "NotificarFalha"
        }
      ],
      "End": true,
      "Comment": "silver/ -> gold/ (star schema: 3 dimensoes + 3 fatos). Agregado por jogador vive em vw_player_360, nao materializado."
    },
    "NotificarFalha": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${sns_topic_arn}",
        "Subject": "[FALHA] pipeline ${project}",
        "Message.$": "States.Format('Execucao: {}\n\nErro: {}\n\nDetalhe: {}\n\nNenhuma camada posterior foi publicada.', $$.Execution.Name, $.erro.Error, $.erro.Cause)"
      },
      "ResultPath": "$.notificacao",
      "Next": "Falhou",
      "Comment": "Avisa antes de morrer. Sem isto a falha so aparece quando alguem abre o console."
    },
    "Falhou": {
      "Type": "Fail",
      "Error": "PipelineFalhou",
      "Cause": "Ver o e-mail do SNS e o relatorio de DQ em quality/dq_report/",
      "Comment": "Falha explicita: a execucao precisa terminar em FAILED para o alarme de ExecutionsFailed disparar."
    }
  }
}
